{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with spiritual stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "currentIdentityId": { "type": "string" },
        "streak": { "type": "integer" },
        "totalVotes": { "type": "integer" },
        "ideasShared": { "type": "integer" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "savedReflections": { "type": "array" },
        "favoriteVerses": { "type": "array" },
        "completedChapters": { "type": "array" },
        "answers": { "type": "object" }
      },
      "required": ["uid", "name", "email", "avatarEmoji"]
    },
    "Semente": {
      "title": "Semente Balance",
      "description": "Real-time balance of sementes",
      "type": "object",
      "properties": {
        "saldo": { "type": "integer" },
        "ultimaAtualizacao": { "type": "string", "format": "date-time" }
      }
    },
    "SementeMovimento": {
      "title": "Semente Movimento",
      "description": "A single movement of planting seeds",
      "type": "object",
      "properties": {
        "tipo": { "type": "string" },
        "descricao": { "type": "string" },
        "valor": { "type": "integer" },
        "criadoEm": { "type": "string", "format": "date-time" }
      }
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message chat meta between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" },
        "lastAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" },
        "reactions": { "type": "object" }
      },
      "required": ["text", "senderUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Saved user profiles"
    },
    "/conversations/{cid}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations"
    },
    "/conversations/{cid}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages inside a conversation"
    },
    "/sementes/{uid}": {
      "schema": { "$ref": "#/entities/Semente" },
      "description": "Vessel for sementes balance (Mateus 6)"
    },
    "/sementes/{uid}/movimentos/{movId}": {
      "schema": { "$ref": "#/entities/SementeMovimento" },
      "description": "Chronicle of sementes actions/rewards"
    }
  }
}
